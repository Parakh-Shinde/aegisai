# Copy to .env.production on the deployment host; NEVER commit that file.
# Generate unique values as described in docs/production-deployment.md.
AEGISAI_DOMAIN=your-real-domain.example
ACME_EMAIL=ops@your-real-domain.example

POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
# Generate a URL-safe hex secret: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_HEX_SECRET

# Generate with: openssl rand -hex 32
AEGISAI_JWT_SECRET=REPLACE_WITH_UNIQUE_HEX_SECRET
# Generate independently with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGISAI_EVIDENCE_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_FERNET_KEY
AEGISAI_MFA_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_FERNET_KEY
# Generate independent random values with: openssl rand -hex 32
AEGISAI_AGENT_GATEWAY_TOKEN=REPLACE_WITH_UNIQUE_HEX_SECRET
AEGISAI_TOOL_RUNNER_TOKEN=REPLACE_WITH_DIFFERENT_HEX_SECRET
AEGISAI_BOOTSTRAP_TOKEN=REPLACE_WITH_DIFFERENT_HEX_SECRET

# Optional: only use a deliberately approved, privacy-reviewed model provider.
# Do not send confidential prompts/evidence to free public model APIs.
OLLAMA_BASE_URL=http://host.docker.internal:11434
