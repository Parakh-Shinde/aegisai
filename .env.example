# AEGISAI runs locally by default. Do not commit your real .env file.

# Local Docker database. Change this to a long unique value before sharing the host.
POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=change-this-local-password

# Used when starting the backend without Docker.
DATABASE_URL=postgresql+psycopg://aegisai:change-this-local-password@127.0.0.1:5432/aegisai

# Docker Desktop on Windows and macOS can reach locally running Ollama here.
# For WSL, replace this with the Windows host IP when needed.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: set a long random local API key before exposing the API beyond your computer.
# AEGISAI_API_KEY=replace-with-a-long-random-value

# Keep false unless you explicitly authorize a trusted remote Ollama endpoint.
AEGISAI_ALLOW_REMOTE_OLLAMA=false
# Required when remote endpoints are explicitly enabled. List exact approved URLs.
AEGISAI_APPROVED_MODEL_ENDPOINTS=
# For WSL, list the exact Windows-host Ollama URL here instead of trusting all 172.* addresses.
# Example: AEGISAI_LOCAL_MODEL_ENDPOINTS=http://172.22.160.1:11434
AEGISAI_LOCAL_MODEL_ENDPOINTS=

# These defaults only allow the local dashboard to call the API.
AEGISAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# API hosts permitted by Host-header validation. Production must set deployed names explicitly.
AEGISAI_TRUSTED_HOSTS=localhost,127.0.0.1
# Bound request bodies, file scans, and model work to reduce resource-exhaustion attacks.
AEGISAI_MAX_REQUEST_BODY_BYTES=1048576
AEGISAI_MAX_FILE_SCAN_BYTES=1048576
AEGISAI_MAX_RAG_SOURCE_CHARACTERS=65536
AEGISAI_MAX_AGENT_ACTION_CHARACTERS=32768
AEGISAI_MODEL_MAX_OUTPUT_TOKENS=512
AEGISAI_MODEL_TIMEOUT_SECONDS=60
AEGISAI_MODEL_MAX_CONCURRENCY=2
# Redis is internal to Docker Compose. Production requires it and async campaigns.
AEGISAI_REDIS_URL=redis://redis:6379/0
AEGISAI_ASYNC_CAMPAIGNS=false
# Keep true only for local development. Production disables /docs and /openapi.json by default.
AEGISAI_EXPOSE_API_DOCS=true
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local mode creates a local Admin automatically to keep the lab friction-free.
# In production set both to true and configure strong secrets before starting.
AEGISAI_ENVIRONMENT=development
AEGISAI_AUTH_REQUIRED=false
VITE_AUTH_REQUIRED=false
VITE_ASYNC_CAMPAIGNS=false
AEGISAI_JWT_SECRET=development-only-secret-change-before-production
# Required in production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AEGISAI_EVIDENCE_ENCRYPTION_KEY=
# Set this once to bootstrap the first production organization administrator.
AEGISAI_BOOTSTRAP_TOKEN=
