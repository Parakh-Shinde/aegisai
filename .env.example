# AEGISAI runs locally by default. Do not commit your real .env file.

# Used when starting the backend without Docker.
DATABASE_URL=sqlite:///./aegisai.db

# Docker Desktop on Windows and macOS can reach locally running Ollama here.
# For WSL, replace this with the Windows host IP when needed.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: set a long random local API key before exposing the API beyond your computer.
# AEGISAI_API_KEY=replace-with-a-long-random-value

# Keep false unless you explicitly authorize a trusted remote Ollama endpoint.
AEGISAI_ALLOW_REMOTE_OLLAMA=false

# These defaults only allow the local dashboard to call the API.
AEGISAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
